{
  "model": "opus",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Bash",
      "Read(//**)",
      "Edit(//**)",
      "Write(//**)",
      "Glob(//**)",
      "Grep(//**)",
      "Task(**)",
      "NotebookEdit(//**)",
      "WebFetch",
      "WebSearch",
      "AskUserQuestion",
      "mcp__puppeteer"
    ],
    "deny": [
      "Bash(rm -rf /:*)",
      "Bash(rm -rf /*:*)",
      "Bash(rm -rf ~:*)",
      "Bash(rm -rf ~/*:*)",
      "Bash(dd if=/dev/zero:*)",
      "Bash(dd if=/dev/random:*)",
      "Bash(mkfs:*)",
      "Bash(fdisk:*)",
      "Bash(parted:*)",
      "Bash(shutdown:*)",
      "Bash(reboot:*)",
      "Bash(poweroff:*)",
      "Bash(halt:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/scripts/status-line.sh"
  },
  "outputStyle": "Explanatory",
  "language": "Japanese",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "xhigh"
    }
  },
  "autoUpdatesChannel": "latest",
  "voice": {
    "enabled": true,
    "mode": "tap"
  },
  "theme": "auto",
  "tui": "fullscreen",
  "autoCompactEnabled": true,
  "fileCheckpointingEnabled": true,
  "autoMode": {
    "allow": [
      "$defaults",
      "git commit and git push to the working repository are allowed"
    ]
  }
}
